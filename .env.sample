# サーバーの host/port は実リクエストから自動取得されるので BASE_URL は不要

# Philips Hue
HUE_BRIDGE_IP=192.168.1.100
HUE_API_KEY=YOUR_HUE_API_KEY
HUE_LIGHT_ID=1
HUE_MOCK=true

# LINE Login
# https://developers.line.biz/console/ で取得
# Callback URL: http://<host:port>/users/auth/line/callback を LINE Developers Console に登録
LINE_CHANNEL_ID=YOUR_LINE_CHANNEL_ID
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET
